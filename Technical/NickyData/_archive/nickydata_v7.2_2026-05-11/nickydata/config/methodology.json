{
  "version": "2.0",
  "source": "Shaikh & Tonak (1994) Measuring the Wealth of Nations",
  "description": "Complete methodology for computing Marxian national accounts from public US data. v2.0: Detail-level IO (412 industries) for TP*, VA-based GFP*.",

  "sector_classification": {
    "rule": "Production = creation/transformation of use values. Trade = circulation. Royalties = transfer of surplus.",
    "productive_naics": [
      "111CA","113FF","211","212","213","22","23",
      "311FT","313TT","315AL","321","322","323","324","325","326","327",
      "331","332","333","334","335","3361MV","3364OT","337","339",
      "481","482","483","484","485","486","487OS","493",
      "512","562",
      "61","621","622","623","624",
      "711AS","713","721","722","81"
    ],
    "trading_naics": ["42","44RT"],
    "unproductive_naics": [
      "511","513","514",
      "521CI","523","524","525",
      "HS","ORE","532RL",
      "5411","5412OP","5415",
      "55","561"
    ],
    "government_naics": ["GFE","GSLE","GFG","GSLG"],

    "productive_nipa65_lines": [4,7,11,12,13,43,73,74,79,82,85,91,96],
    "trading_nipa65_lines": [35,38],
    "unproductive_nipa65_lines": [52,57,62,65,69]
  },

  "formulas": {
    "TP_star": "sum(GO_j) for j in productive + trading sectors (412-industry detail, UnderlyingGDPbyIndustry TableID=237)",
    "C_star_m": "TP_star - GFP_star (derived from gross output minus value added)",
    "GFP_star": "sum(VA_j) for j in productive + trading sectors (summary-level IO codes, UnderlyingGDPbyIndustry TableID=210)",
    "V_star": "sum(ec_j * (Lp/L)_j * FEE_j) for j in productive sectors",
    "S_star": "GFP_star - Dp - V_star (where Dp = depreciation of productive capital)",
    "exploitation_rate": "e = S_star / V_star",
    "surplus_ratio": "S_star / (S_star + V_star)",
    "profit_rate": "r_star = S_star / K_star",
    "K_star": "K_total * productive_output_ratio",
    "Lp": "sum(production_workers_j) for j in productive sectors, adjusted by IO ratio",
    "NSW": "benefits_to_workers - taxes_on_workers (Appendix N 3-group methodology)",
    "labor_values": "lambda_star = hp_star * (I - A)^(-1)"
  },

  "parameters": {
    "io_interpolation_method": "linear",
    "production_worker_hours_annual": 2000,
    "gdp_deflator_base_year": 1982,
    "nsw_group1_allocation": 1.0,
    "nsw_group2_allocation": "labor_share",
    "nsw_group3_allocation": 0.0,
    "labor_share_definition": "EC / PI from NIPA 2.1",
    "production_worker_fraction": 0.65,
    "ec_p_ec_avg_ratio": 0.95,
    "fallback_tp_gdp_ratio": 1.05,
    "fallback_cm_tp_ratio": 0.65
  },

  "io_data_sources": {
    "detail_go": "UnderlyingGDPbyIndustry TableID=237 (412 industries, annual 1997-2024)",
    "summary_va": "UnderlyingGDPbyIndustry TableID=210 (67 summary codes matching IO classification, annual 1997-2024)",
    "io_use_summary": "InputOutput TableID=259 (71 sectors, annual 1997-2024)",
    "book_sic": "Table H.1 Shaikh & Tonak (82 SIC sectors, 1948-1989)",
    "transition_method": "Log-linear interpolation of TP*/GDP ratio (1990-1996)"
  },

  "io_benchmark_years": {
    "sic": [1947, 1958, 1963, 1967, 1972, 1977],
    "naics_annual": "1997-2024 (all years from UnderlyingGDPbyIndustry)"
  },

  "nsw_expenditure_groups": {
    "group_1_direct": {"nipa_3_16_lines": {"income_security": 36}},
    "group_2_labor_share": {"nipa_3_16_lines": {"education": 30, "health": 28, "transportation": 14}},
    "group_3_excluded": {"nipa_3_16_lines": {"national_defense": 7, "public_order_safety": 8}}
  },

  "bls_production_worker_series": {
    "Mining": {"production": "CES1000000006", "total": "CES1000000001"},
    "Construction": {"production": "CES2000000006", "total": "CES2000000001"},
    "Manufacturing": {"production": "CES3000000006", "total": "CES3000000001"},
    "Total_private": {"production": "CES0500000006", "total": "CES0500000001"}
  }
}
